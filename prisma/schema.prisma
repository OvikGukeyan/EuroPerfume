generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  fullName         String
  email            String            @unique
  password         String
  role             UserRole          @default(USER)
  verified         DateTime?
  provider         String?
  providerId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cart             Cart?
  favorites        Favorites?
  orders           Order[]
  verificationCode VerificationCode?
  Review           Review[]
  addresses        CustomerAddress[]
  accountConsent   AccountConsent?
  adminNotificationSeen AdminNotificationSeen[]
  legacyNewsletterReward LegacyNewsletterReward?
  couponRedemptions CouponRedemption[]
  loyaltyWallet LoyaltyWallet?
  loyaltyEntries LoyaltyEntry[]
  welcomeNotice WelcomeNotice?
  marketingDeliveries MarketingDelivery[]
}

model Category {
  id            Int            @id @default(autoincrement())
  labelRu       String         @unique
  labelDe       String         @unique
  products      Product[]
  productGroups ProductGroup[]
}

model ProductGroup {
  id         Int       @id @default(autoincrement())
  labelRu    String    @unique
  labelDe    String    @unique
  products   Product[]
  onTap      Boolean?
  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId Int
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  imageUrl       String[]
  videoUrl       String?
  categoryId     Int
  productGroupId Int
  gender         Gender?
  classification Classification[]
  series         String?
  volume         String?

  age     Int?
  purpose Purpose[]
  finish  Finish[]

  texture Texture[]
  formula Formula[]

  effect         Effect[]
  effectDuration Int?
  hypoallergenic Boolean?

  applicationMethod ApplicationMethod[]
  packagingFormat   PackagingFormat[]

  skinType SkinType[]
  size     String?

  productNotes  ProductNote[]
  aromas        Aroma[]
  concentration PerfumeConcentration?
  perfumer      String?
  brand         Brand                 @relation(fields: [brandId], references: [id])
  brandId       Int

  price         Decimal
  discountPrice Decimal?
  dayOfferSlides Slide[] @relation("DayOfferSlides")
  dayOfferReferenceCheckedAt DateTime? @db.Timestamptz(3)
  dayOfferStartsAt DateTime? @db.Timestamptz(3)
  dayOfferEndsAt DateTime? @db.Timestamptz(3)
  releaseYear   Int?
  isBestseller  Boolean?

  available      Boolean
  cartItems      CartItem[]
  favoritesItems FavoritesItem[]
  category       Category             @relation(fields: [categoryId], references: [id])
  productGroup   ProductGroup         @relation(fields: [productGroupId], references: [id])
  translations   ProductTranslation[]
  reviews        Review[]
  variations     ProductVariation[]
  OrderItem      OrderItem[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  popularProducts PopularProducts[] @relation("PopularProductsOnProducts")
  StockMovement   StockMovement[]
  bottleParentId Int?
  bottleParent Product? @relation("FullBottles", fields: [bottleParentId], references: [id], onDelete: Restrict)
  fullBottles Product[] @relation("FullBottles")
  @@unique([bottleParentId, volume])
  stockMl         Int               @default(0)
  allowBackorder  Boolean           @default(false)
  stockPieces     Int               @default(0)

  supplyItems SupplyItem[]
}

model PopularProducts {
  id        Int       @id @default(autoincrement())
  date      DateTime  @unique
  products  Product[] @relation("PopularProductsOnProducts")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProductVariation {
  id            Int             @id @default(autoincrement())
  name          String
  imageUrl      String
  available     Boolean         @default(true)
  order         Int             @default(0)
  productId     Int
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  CartItem      CartItem[]
  OrderItem     OrderItem[]
  StockMovement StockMovement[]
  stockPieces   Int             @default(0)

  supplyItems SupplyItem[]
}

model ProductTranslation {
  id       Int       @id @default(autoincrement())
  language Languages

  description          String
  colorPalette         String?
  compositionFeatures  String?
  activeIngredients    String?
  certificates         String?
  ethics               String?
  material             String?
  brandCountry         String?
  manufacturingCountry String?

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([language, productId], name: "translation_unique")
}

model ProductNote {
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  note      Note     @relation(fields: [noteId], references: [id])
  noteId    Int
  noteType  NoteType

  @@id([productId, noteId, noteType])
}

model Note {
  id           Int           @id @default(autoincrement())
  labelRu      String        @unique
  labelDe      String        @unique
  productNotes ProductNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Effect {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purpose {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkinType {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Classification {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PackagingFormat {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Finish {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationMethod {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Texture {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Formula {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Aroma {
  id       Int       @id @default(autoincrement())
  labelRu  String    @unique
  labelDe  String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Cart {
  id          Int        @id @default(autoincrement())
  userId      Int?       @unique
  token       String
  totalAmount Decimal    @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  promotions CartPromotion[]
}

model CartItem {
  id          Int               @id @default(autoincrement())
  cartId      Int
  quantity    Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  productId   Int
  variationId Int?
  cart        Cart              @relation(fields: [cartId], references: [id])
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Favorites {
  id        Int             @id @default(autoincrement())
  userId    Int?            @unique
  token     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     FavoritesItem[]
}

model FavoritesItem {
  id          Int       @id @default(autoincrement())
  favoritesId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  productId   Int
  favorites   Favorites @relation(fields: [favoritesId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  rating    Int
  imageUrl  String[]
  reply     Reply?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reply {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                  Int             @id @default(autoincrement())
  userId              Int?
  token               String
  totalAmount         Decimal
  pricingSnapshot     Json?
  status              OrderStatus
  peymentId           String?
  items               OrderItem[]
  fullName            String
  deliveryFullNmae    String
  address             String
  houseNumber         String
  deliveryAddress     String
  deliveryHouseNumber String
  city                String
  country             String
  deliveryCity        String
  deliveryCountry     String
  zip                 String
  deliveryZip         String
  postNumber          String?
  postOffice          String?
  packstationNumber   String?
  email               String
  phone               String
  comment             String?
  promocode           String?
  discount            Int?
  shippingMethod      ShippingMethods
  contactForm         ContactForms
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  trackingCode        String?
  shipments           Shipment[]
  user                User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice             Invoice?
  promotions          OrderPromotion[]
  couponRedemption CouponRedemption?
  loyaltyEntries LoyaltyEntry[]
  fulfillment OrderFulfillment?
}

model Shipment {
  id          Int      @id @default(autoincrement())
  orderId     Int
  carrier     String   @default("GHL")
  shipmentNo  String   @unique
  routingCode String?
  labelUrl    String?
  status      String   @default("CREATED") // CREATED | HANDED_OVER | IN_TRANSIT | DELIVERED | CANCELED ...
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InvoiceCounter {
  id        Int @id @default(autoincrement())
  year      Int @unique
  lastValue Int
}

model OrderItem {
  id            Int               @id @default(autoincrement())
  name          String
  quantity      Int
  variationId   Int?
  variation     ProductVariation? @relation(fields: [variationId], references: [id])
  orderId       Int
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  productId     Int
  StockMovement StockMovement[]
}

model PromoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  discount   Int
  isActive   Boolean   @default(true)
  disposable Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

model Slide {
  dayOfferProductId Int?
  dayOfferProduct Product? @relation("DayOfferSlides", fields:[dayOfferProductId], references:[id], onDelete:Cascade)
  visibleFrom DateTime? @db.Timestamptz(3)
  visibleUntil DateTime? @db.Timestamptz(3)
  id       Int          @id @default(autoincrement())
  name     String
  images   SlideImage[]
  href     String
  location Int
  order    Int          @default(0)
}

model SlideImage {
  id         Int       @id @default(autoincrement())
  language   Languages
  desctopImg String
  mobileImg  String

  slideId Int
  Slide   Slide @relation(fields: [slideId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id Int @id @default(autoincrement())

  product   Product? @relation(fields: [productId], references: [id])
  productId Int?

  variation   ProductVariation? @relation(fields: [variationId], references: [id])
  variationId Int?

  supply   Supply? @relation(fields: [supplyId], references: [id])
  supplyId Int?

  type      StockMovementType
  unit      StockUnit
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())

  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  orderItemId Int?
}

model Supply {
  id             Int             @id @default(autoincrement())
  supplier       String?
  note           String?
  createdAt      DateTime        @default(now())
  items          SupplyItem[]
  stockMovements StockMovement[]
}

model SupplyItem {
  id          Int       @id @default(autoincrement())
  supplyId    Int
  productId   Int
  variationId Int?
  quantity    Decimal
  unit        StockUnit
  costPrice   Decimal?

  supply    Supply            @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id])
  variation ProductVariation? @relation(fields: [variationId], references: [id])
}

model Invoice {
  document InvoiceDocument?
  corrections InvoiceCorrection[]
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique
  orderId       Int    @unique
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  taxSnapshot Json?
  supplyDate DateTime? @db.Date
  pdfUrl   String?
  issuedAt DateTime @default(now())

  year          Int
  customerEmail String?

  createdAt DateTime @default(now())
}

model InvoiceCorrectionCounter {
  year Int @id
  value Int
}

model InvoiceCorrection {
  id String @id
  number String @unique
  invoiceId Int
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  grossCents Int
  vatCents Int
  issuedAt DateTime @db.Timestamptz(6)
  snapshot Json
  pdf Bytes
  requestHash String
  actorId Int
  refund InvoiceRefund?
  @@index([invoiceId])
}

model InvoiceRefund {
  correctionId String @id
  correction InvoiceCorrection @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  paidAt String
  reference String
  actorId Int
  recordedAt DateTime @default(now()) @db.Timestamptz(6)
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum StockUnit {
  ML
  PIECE
}

enum SupplyStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum OrderStatus {
  NEW
  PENDING
  SUCCEEDED
  CENCELLED
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum PerfumeConcentration {
  EXTRAIT
  PERFUME
  EAU_DE_PARFUM
  EAU_DE_TOILETTE
  EAU_DE_COLOGNE
  ELIXIR
}

enum NoteType {
  TOP
  HEART
  BASE
}

enum Languages {
  RU
  DE
}

enum ContactForms {
  WA
  VB
  TG
}

enum ShippingMethods {
  BILLING_ADDRESS
  DIFFERENT_ADDRESS
  PACKSTATION
  POST_OFFICE
}

// Submitted declarations are server-only. The Supabase migration enables RLS
// and revokes browser roles; access uses the existing server database connection.
model WithdrawalRequest {
  id                  String    @id @default(uuid()) @db.Uuid
  fullName            String
  email               String
  contractIdentifier  String
  locale              String
  receivedAt          DateTime  @default(now()) @db.Timestamptz(3)
  confirmationSentAt  DateTime? @db.Timestamptz(3)
  confirmationEmailId String?
  receiptText         String
}

model InvoiceDocument {
 invoiceId Int @id
 invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
 pdf Bytes
 sha256 String
 sourceUrl String?
 archivedAt DateTime @default(now()) @db.Timestamptz(6)
}

model Promotion {
  id             String   @id @default(uuid())
  slug           String   @unique
  titleRu        String
  titleDe        String
  active         Boolean  @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  priority       Int      @default(0)
  viewCount      Int      @default(0)
  clickCount     Int      @default(0)
  addCount       Int      @default(0)
  requiredMl     Int      @default(5)
  giftMl         Int      @default(2)
  heroImage      String?
  productIds     Int[]    @default([])
  giftProductId  Int?
  allowMultiple  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  carts          CartPromotion[]
  orders         OrderPromotion[]
}

model CartPromotion {
  id          String @id @default(uuid())
  cartId      Int
  promotionId String
  cart        Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  addedAt     DateTime @default(now())
  @@unique([cartId,promotionId])
}

model OrderPromotion {
  id          String @id @default(uuid())
  orderId     Int
  promotionId String
  snapshot    Json
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  @@unique([orderId,promotionId])
}

model CustomerAddress {
  id String @id @default(uuid())
  userId Int
  fullName String
  street String
  houseNumber String
  city String
  postalCode String
  country String
  phone String @default("")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AdminNotification {
  id BigInt @id @default(autoincrement())
  category String
  kind String
  sourceKey String @unique
  userId Int?
  orderId Int?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  seen AdminNotificationSeen[]
  @@index([category,createdAt])
  @@index([createdAt])
}

model AdminNotificationSeen {
  adminId Int
  notificationId BigInt
  seenAt DateTime @default(now()) @db.Timestamptz(6)
  notification AdminNotification @relation(fields:[notificationId],references:[id],onDelete:Cascade)
  admin User @relation(fields:[adminId],references:[id],onDelete:Cascade)
  @@id([adminId,notificationId])
  @@index([adminId])
}

model AccountConsent {
  userId Int @id
  locale String
  termsVersion String
  privacyVersion String
  termsText String
  privacyNotice String
  marketingText String
  acceptedAt DateTime? @default(now())
  marketingRequestedAt DateTime?
  marketingConfirmedAt DateTime?
  marketingWithdrawnAt DateTime?
  confirmationTokenHash String? @unique
  confirmationExpiresAt DateTime?
  confirmationSentAt DateTime?
  confirmationEmailId String?
  unsubscribeTokenHash String? @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** New rewards infrastructure is separate from Shopify and legacy promo codes. */
model LegacyNewsletterReward {
  userId Int @id
  requestedAt DateTime @default(now())
  code String? @unique
  grantedAt DateTime?
  expiresAt DateTime?
  emailClaimedAt DateTime?
  emailSentAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@index([grantedAt])
}

model CouponPolicy {
  code String @id
  // WELCOME, PER_ACCOUNT, or UNLIMITED. Existing PromoCode remains unchanged.
  kind String @default("PER_ACCOUNT")
  active Boolean @default(true)
  validDaysAfterVerification Int?
  perUserLimit Int @default(1)
  globalLimit Int?
  usedCount Int @default(0)
  epoch Int @default(1)
  startsAt DateTime?
  endsAt DateTime?
  redemptions CouponRedemption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponRedemption {
  id String @id @default(uuid())
  code String
  epoch Int
  userId Int
  orderId Int @unique
  discountCents Int
  redeemedAt DateTime @default(now())
  policy CouponPolicy @relation(fields: [code], references: [code], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([code,epoch,userId])
}

model LoyaltyWallet {
  userId Int @id
  balancePoints Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model LoyaltyEntry {
  id String @id @default(uuid())
  userId Int
  orderId Int?
  points Int
  kind String
  idempotencyKey String @unique
  note String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([userId,createdAt])
}

model OrderFulfillment {
  orderId Int @id
  paymentConfirmedAt DateTime?
  shippedConfirmedAt DateTime?
  loyaltyAwardedAt DateTime?
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model WelcomeNotice {
  userId Int @id
  claimAt DateTime @default(now())
  sentAt DateTime?
  user User @relation(fields: [userId],references: [id],onDelete: Restrict)
}

model MarketingCampaign {
  id String @id @default(uuid())
  segment String @default("ALL")
  name String
  subjectRu String
  subjectDe String
  bodyRu String @db.Text
  bodyDe String @db.Text
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries MarketingDelivery[]
}

model MarketingDelivery {
  id String @id @default(uuid())
  campaignId String
  userId Int
  status String @default("QUEUED")
  providerId String?
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign MarketingCampaign @relation(fields: [campaignId],references: [id],onDelete: Restrict)
  user User @relation(fields: [userId],references: [id],onDelete: Restrict)
  @@unique([campaignId,userId])
  @@index([campaignId,status])
}
